<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/white</item>
        //fix mầu khi back từ setting về home
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
    </style>

    <style name="ActivityAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/out_right</item>
    </style>

    <style name="PrimaryTabTheme" parent="AppTheme">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="RadioButtonStyle" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/chill_green_5</item>
        <item name="android:textColorSecondary">@color/black</item>
    </style>

    <style name="BaseDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="SettingsRowValue">
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxWidth">@dimen/_110sdp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/chill_green_35</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/_3sdp</item>
        <item name="android:background">#1A0E0007</item>
    </style>

    <style name="header_small">
        <item name="android:textSize">24sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
    </style>

    <style name="label_small">
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>

    <style name="label_medium">
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>

    <style name="label_large">
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
    </style>

    <style name="body_medium">
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>

    <style name="body_large">
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>

    <style name="tittle_small">
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
    </style>

    <style name="tittle_medium">
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
    </style>


    <style name="tittle_large">
        <item name="android:textSize">22sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
    </style>

    <style name="tittle_semi_large">
        <item name="android:textSize">19sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>
</resources>
