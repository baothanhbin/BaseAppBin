<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:background="@drawable/bg_bottom_bar_home"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:background="@drawable/bg_green_corner"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tabAdd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.38">

        <ImageView
            android:id="@+id/ivHomeTab"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home" />

        <com.example.basekotlin.view.AlwaysMarqueeTextView
            android:id="@+id/tvHomeTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:text="@string/home"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tabAdd"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_green_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tabChannel"
        app:layout_constraintStart_toEndOf="@id/tabHome"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_add"
            app:tint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabChannel"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:background="@drawable/bg_channel"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tabAdd"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.38">

        <com.example.basekotlin.view.AlwaysMarqueeTextView
            android:id="@+id/tvChannelTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:text="@string/channel"
            android:textColor="@color/chip_channel"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivChannelTab"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_channel"
            app:tint="@color/chip_channel" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
